{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "Today's Allowance",
      "weight": "Bolder",
      "size": "Medium",
      "color": "Light",
      "fontType": "Default"
    },
    {
      "type": "TextBlock",
      "text": "${amount}",
      "size": "ExtraLarge",
      "weight": "Bolder",
      "color": "${status}",
      "spacing": "Small"
    },
    {
      "type": "TextBlock",
      "text": "${message}",
      "isSubtle": true,
      "wrap": true,
      "size": "Small",
      "spacing": "Small"
    },
    {
      "type": "TextBlock",
      "text": "Spent today: ${spentToday}",
      "isSubtle": true,
      "size": "Small",
      "spacing": "Medium"
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "Open Folio",
      "url": "/"
    }
  ]
}
