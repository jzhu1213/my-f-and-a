    "framer-motion": "^12.42.2",
    "jspdf": "3.0.3",
    "lucide-react": "^1.28.0",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "14.2.35",
    "@testing-library/react": "^16.3.2",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^20.12.12",
    "@types/react": "18.3.3",
