# ──────────────────────────────────────────────────────────────────────────────
# Environment Variables for Folio
# ──────────────────────────────────────────────────────────────────────────────
# NOTE: Only variables prefixed with NEXT_PUBLIC_ are exposed to the client
# bundle. All other variables are server-only and never reach the browser.
# ──────────────────────────────────────────────────────────────────────────────

# Supabase Configuration (CLIENT-SAFE)
# Get these values from your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key — SERVER-ONLY
# ⚠️  WARNING: This key bypasses Row Level Security. It MUST NOT use the
# NEXT_PUBLIC_ prefix — that would expose it to the client bundle.
# Only uncomment if you have server-side operations that require admin access.
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: Plaid account linking (task 107.1) — SERVER-ONLY, opt-in.
# These MUST NOT use the NEXT_PUBLIC_ prefix (that would leak secrets into the
# client bundle). They are read only in server code. Leave unset to keep the
# optional account-linking feature in its graceful "not configured" state.
# Do NOT commit real credentials.
# PLAID_CLIENT_ID=your_plaid_client_id
# PLAID_SECRET=your_plaid_secret
# PLAID_ENV=sandbox
