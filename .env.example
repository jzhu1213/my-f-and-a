# Supabase Configuration
# Get these values from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: Plaid account linking (task 107.1) — SERVER-ONLY, opt-in.
# These MUST NOT use the NEXT_PUBLIC_ prefix (that would leak secrets into the
# client bundle). They are read only in server code. Leave unset to keep the
# optional account-linking feature in its graceful "not configured" state.
# Do NOT commit real credentials.
# PLAID_CLIENT_ID=your_plaid_client_id
# PLAID_SECRET=your_plaid_secret
# PLAID_ENV=sandbox
